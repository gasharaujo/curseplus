<Window x:Class="CursePlus.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="CursePlus" Width="1280" Height="860" MinWidth="1060" MinHeight="740" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded">
<Grid Background="#111319"><Grid Margin="28,23">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,22">
<StackPanel Orientation="Horizontal"><Border Background="#F78B52" CornerRadius="10" Width="45" Height="45" Margin="0,0,13,0"><TextBlock Text="+" Foreground="#171A22" FontSize="35" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border><StackPanel><TextBlock Text="CursePlus" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Seus perfis. Suas mudanças." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></StackPanel>
<Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#222833" CornerRadius="14" Padding="12,6"><TextBlock Text="BETA · MINECRAFT · WINDOWS" FontSize="10" Foreground="#BEC7D5"/></Border>
</Grid>
<Border Grid.Row="1" Background="#1B1F28" CornerRadius="9" Padding="17,14" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Perfil selecionado" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ProfilePicker" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="ProfileChanged"/><TextBlock x:Name="ProfileSummary" Grid.Column="2" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"/><Button Grid.Column="3" Content="Atualizar" Click="RefreshClick" Margin="0"/></Grid></Border>
<TabControl Grid.Row="2" x:Name="Tabs">
<TabItem Header="Instância"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Text="Personalizações da instância" FontSize="23" FontWeight="SemiBold"/>
<TextBlock Grid.Row="1" Text="Defina o original para exportar somente diferenças. Arquivos inalterados ficam fora da exportação." Foreground="{StaticResource Muted}" Margin="0,7,0,18"/>
<WrapPanel Grid.Row="2" Margin="0,0,0,17"><Button Content="Exportar alterações" Background="#A95029" Click="ExportClick"/><Button Content="Comparar com original" Click="CompareOriginalClick"/><Button Content="Salvar ponto" Click="SaveSnapshotClick"/><Button Content="Definir original" Click="CaptureOriginalClick"/><Button Content="Quick add com seleção" Click="PresetFromSelectionClick"/></WrapPanel>
<Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="InventorySummary" Text="Selecione uma instância para começar." Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><DataGrid Grid.Row="1" x:Name="ModsGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="MOD" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PROJETO" Binding="{Binding ProjectId}" Width="110"/><DataGridTextColumn Header="ARQUIVO" Binding="{Binding FileId}" Width="110"/><DataGridCheckBoxColumn Header="ATIVO" Binding="{Binding Enabled}" Width="80"/><DataGridCheckBoxColumn Header="MODIFICADO" Binding="{Binding Modified}" Width="110"/></DataGrid.Columns></DataGrid></Grid>
</Grid></TabItem>
<TabItem Header="Sincronizar"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Aplicar mudanças em um perfil" FontSize="23" FontWeight="SemiBold"/>
<DockPanel Grid.Row="1" Margin="0,14,0,12"><Button Content="Abrir pacote" Click="LoadBundleClick" DockPanel.Dock="Left"/><TextBlock x:Name="LoadedBundleText" Text="Escolha um arquivo .curseplus.zip" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
<WrapPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="Destino" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="TargetPicker" DisplayMemberPath="Name" Width="250" Margin="0,0,12,0" SelectionChanged="PreviewInputChanged"/><ComboBox x:Name="ModePicker" Width="190" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="PreviewInputChanged"><ComboBoxItem Content="Preferir A (origem)"/><ComboBoxItem Content="Mesclar com destino"/></ComboBox><Button Content="Gerar prévia" Click="PreviewClick"/><Button Content="Novo perfil" Click="NewProfileClick"/><Button Content="Vincular perfil próprio" Click="BindOriginClick"/></WrapPanel>
<TextBlock Grid.Row="3" x:Name="PlanSummary" Text="Revise instalações, remoções, conflitos e arquivos personalizados antes de aplicar." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
<DataGrid Grid.Row="4" x:Name="PlanGrid"><DataGrid.Columns><DataGridTextColumn Header="ALTERAÇÃO" Binding="{Binding Description}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="DETALHE" Binding="{Binding Detail}" IsReadOnly="True" Width="230"/><DataGridTemplateColumn Header="MANTER B" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding KeepTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChoose}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
<DockPanel Grid.Row="5" Margin="0,16,0,0"><Button x:Name="ApplyButton" Content="Aplicar no destino" Background="#A95029" Click="ApplyClick" IsEnabled="False" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBlock Text="Mundos e dados pessoais ficam fora da sincronização." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
</Grid></TabItem>
<TabItem Header="Quick add"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Suas listas" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><ListBox x:Name="PresetPicker" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="PresetChanged"/><WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Importar" Click="ImportPresetClick"/><Button Content="Exportar" Click="ExportPresetClick"/></WrapPanel></Grid>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="PresetName" ToolTip="Nome da lista" Margin="0,0,0,12"/><TextBlock Grid.Row="1" Text="A lista guarda o ID do projeto. O CurseForge escolhe uma versão compatível com o perfil." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,15"/><DataGrid x:Name="PresetModsGrid" Grid.Row="2" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="MOD" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="ID DO PROJETO" Binding="{Binding ProjectId}" Width="150"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button Content="Salvar lista" Click="SavePresetClick"/><Button Content="Adicionar seleção" Click="AddPresetModsClick"/><Button Content="Remover selecionados" Click="RemovePresetModsClick"/><Button Content="Aplicar ao perfil" Background="#A95029" Click="ApplyPresetClick"/></WrapPanel></Grid>
</Grid></TabItem>
<TabItem Header="Restaurar"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Volte a um estado conhecido" FontSize="23" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="O original corresponde à versão publicada do pack. Pontos salvos também guardam versões anteriores." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,17"/><ListBox Grid.Row="2" x:Name="SnapshotPicker"/><WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button Content="Restaurar ponto" Click="RestoreSnapshotClick"/><Button Content="Ponto em novo perfil" Click="RestoreSnapshotNewClick"/><Button Content="Restaurar original" Click="RestoreOriginalClick"/><Button Content="Original em novo perfil" Click="RestoreOriginalNewClick"/></WrapPanel></Grid></TabItem>
<TabItem Header="Configurações"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Conexão com o CurseForge" FontSize="23" FontWeight="SemiBold"/>
<TextBlock Text="Pasta Instances do Minecraft" Foreground="{StaticResource Muted}" Margin="0,20,0,7"/><DockPanel><Button Content="Escolher pasta" Click="ChooseInstancesClick" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="InstancesPath"/></DockPanel>
<TextBlock Text="Executável do CurseForge" Foreground="{StaticResource Muted}" Margin="0,17,0,7"/><DockPanel><Button Content="Localizar" Click="ChooseExecutableClick" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="ExecutablePath"/></DockPanel>
<WrapPanel Margin="0,19,0,0"><Button Content="Salvar configurações" Click="SaveSettingsClick"/><Button Content="Verificar conexão" Click="CheckConnectionClick"/><Button Content="Exportar diagnóstico" Click="ExportDiagnosticClick"/><Button Content="Abrir dados do CursePlus" Click="OpenDataClick"/></WrapPanel>
<Border Background="#222833" CornerRadius="8" Padding="16" Margin="0,22,0,0"><TextBlock Text="O CurseForge executa as operações de mods e perfis. Configs, scripts e mods locais/modificados usam escrita direta somente quando falta uma ação nativa para aplicar o arquivo ao perfil existente. Deixe o Minecraft fechado durante as alterações." Foreground="#B9C3D2" TextWrapping="Wrap"/></Border>
<TextBlock Text="Operações anteriores" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/><ListBox x:Name="JournalPicker" Height="110" DisplayMemberPath="Name"/><Button Content="Revisar / retomar selecionada" Click="ResumeClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></TabItem>
</TabControl>
<Grid Grid.Row="3" Margin="0,15,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button x:Name="CancelButton" Content="Interromper" Click="CancelClick" DockPanel.Dock="Right" Visibility="Collapsed" Margin="10,0,0,0"/><TextBlock x:Name="StatusText" Text="Pronto para começar." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel><ProgressBar x:Name="Progress" Grid.Row="1" Height="3" Margin="0,10,0,0" Foreground="#F78B52" Background="#292D38" Visibility="Collapsed"/></Grid>
</Grid></Grid></Window>
